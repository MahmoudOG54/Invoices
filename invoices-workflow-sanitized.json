      "name": "Message a model"
    },
    {
      "parameters": {
        "sendTo": "billing@example.com",
        "subject": "={{ $json.subjectLine }}",
        "message": "={{ $json.EmailBody }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1184,
        320
      ],
      "id": "f56cb3ad-3f51-486c-9da8-8cf075d08a3f",
      "name": "Send a message",
      "webhookId": "demo-webhook-send-a-message"
    },
    {
      "parameters": {
        "jsCode": "\nconst extractedData = $('Information Extractor').first().json;\n\n// Information Extractor returns the fields inside \"output\"\nconst invoiceData = extractedData.output ?? extractedData;\n\nconst customerName =\n  invoiceData.customer_name ||\n  invoiceData['Customer Name'] ||\n  invoiceData.customerName ||\n  'Valued Customer';\n\nconst invoiceNumber =\n  invoiceData.invoice_number ||\n  invoiceData['Invoice Number'] ||\n  invoiceData.invoiceNumber ||\n  'N/A';\n\nconst subjectLine = `Re: Invoice Received for ${customerName} - ${invoiceNumber}`;\n\nconst emailBody = `<html>\n<body>\n  <p>Dear <b>${customerName}</b> Team,</p>\n  <p>We have successfully received your invoice <b>${invoiceNumber}</b> and it is currently being processed.</p>\n  <p>Thank you for your business!</p>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    subjectLine,\n    EmailBody: emailBody\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        320
      ],
      "id": "9fa77916-9c8d-4bd5-b859-b19f9eb1a63f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nconst raw = $input.item.json;\nconst item = raw.output ?? raw;\n\nconst subtotal = Number(item.subtotal ?? item.Subtotal);\nconst shipping = Number(\n  item.shipping_and_handling ?? item['Shipping & Handling'] ?? item.shipping\n);\nconst totalDue = Number(\n  item.total_amount_due ?? item['Total Amount Due'] ?? item.total\n);\n\nconst hasRequiredValues =\n  item.subtotal != null &&\n  (item.shipping_and_handling != null ||\n    item['Shipping & Handling'] != null ||\n    item.shipping != null) &&\n  (item.total_amount_due != null ||\n    item['Total Amount Due'] != null ||\n    item.total != null) &&\n  Number.isFinite(subtotal) &&\n  Number.isFinite(shipping) &&\n  Number.isFinite(totalDue);\n\nconst calculatedTotal = subtotal + shipping;\nconst difference = Math.abs(calculatedTotal - totalDue);\n\nconst status = !hasRequiredValues\n  ? 'Needs Review ⚠️'\n  : difference <= 0.05\n    ? 'Valid ✅'\n    : 'Needs Review ⚠️';\n\nreturn [{\n  json: {\n    ...item,\n    'Financial Status': status,\n    'Calculated Total': hasRequiredValues\n      ? calculatedTotal.toFixed(2)\n      : null,\n    'Difference': hasRequiredValues\n      ? difference.toFixed(2)\n      : null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -16
      ],
      "id": "7ab865ec-4e32-4cfe-8923-5c79aca9ed44",
      "name": "Code in JavaScript1"
    },
