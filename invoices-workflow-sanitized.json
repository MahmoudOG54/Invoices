    {
      "parameters": {
        "jsCode": "\nconst rawInvoice = $('Information Extractor').first().json;\nconst currentInvoice = rawInvoice.output ?? rawInvoice;\n\nconst currentInvoiceNumber = String(\n  currentInvoice.invoice_number ??\n  currentInvoice['Invoice Number'] ??\n  currentInvoice.invoiceNumber ??\n  ''\n).trim();\n\nif (!currentInvoiceNumber) {\n  throw new Error('Invoice number is missing from Information Extractor');\n}\n\nconst rawRows = $input.all();\n\nconst isDuplicate = rawRows.some(({ json }) => {\n  const row = json ?? {};\n\n  const sheetInvoiceNumber = String(\n    row['Invoice Number'] ??\n    row.invoice_number ??\n    row.invoiceNumber ??\n    ''\n  ).trim();\n\n  return sheetInvoiceNumber !== '' &&\n    sheetInvoiceNumber === currentInvoiceNumber;\n});\n\nreturn [{\n  json: {\n    ...currentInvoice,\n    'Duplicate Status': isDuplicate ? 'Duplicate ⚠️' : 'New ✅',\n    isDuplicate\n  }\n}];\n"
      },
